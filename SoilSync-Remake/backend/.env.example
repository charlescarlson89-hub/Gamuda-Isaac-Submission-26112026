# Non-secret defaults. Keep real credentials in %LOCALAPPDATA%/SoilSyncRemake/.env.
APP_ENV=development
DATABASE_URL=
ADMIN_DATABASE_URL=
MONGODB_RECIPE_URI=
MONGODB_RECIPE_DATABASE=soilsync
# Read-only account directory. Empty disables admin access; set IDs privately.
ADMIN_USER_IDS=[]
FRONTEND_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
COOKIE_SECURE=false
SESSION_HOURS=24
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FIREBASE_PROJECT_ID=soilsync-bdd70
GOOGLE_APPLICATION_CREDENTIALS=
# Recommended: private photos in PostgreSQL (run migrations through 0003).
UPLOAD_STORAGE=postgres
FIREBASE_STORAGE_BUCKET=soilsync-bdd70.firebasestorage.app
# Optional local Firebase mode: UPLOAD_STORAGE=firebase and this loopback host.
STORAGE_EMULATOR_HOST=
