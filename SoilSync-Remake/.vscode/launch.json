{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SoilSync: Start full app",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SoilSync: Start backend (FastAPI)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:backend",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SoilSync: Frontend preview",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true
    }
  ]
}
